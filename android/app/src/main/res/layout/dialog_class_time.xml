<?xml version="1.0" encoding="utf-8"?>
<!-- The popup behind the "Class time" button on the home screen. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/dialog_class_time_message"
        android:textSize="13sp"
        android:textColor="#6C757D" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/dialog_start_time_label"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/dialogStartTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="time"
        android:singleLine="true"
        android:hint="08:00" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/dialog_early_label"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/dialogEarlyBefore"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="number"
        android:singleLine="true"
        android:hint="15" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/dialog_late_label"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/dialogLateAfter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="number"
        android:singleLine="true"
        android:hint="10" />
</LinearLayout>
